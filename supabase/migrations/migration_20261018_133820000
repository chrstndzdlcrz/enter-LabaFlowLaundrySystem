-- ------------------------------------------------------- soap per wash rule
-- 100 ml detergent, 100 ml conditioner and 10 ml bleach for every wash.
-- One wash covers a full wash cycle, so a quantity inside the service's per-wash
-- cap counts as a single load.
update public.service_consumables sc
   set qty_per_unit = r.qty,
       unit = 'ml',
       basis = 'wash',
       is_placeholder = false
  from public.services s,
       public.inventory_items i,
       (values
         ('Wash, Dry & Fold', 'Surf Liquid Detergent', 100::numeric),
         ('Wash, Dry & Fold', 'Surf Fabric Conditioner', 100::numeric),
         ('Wash, Dry & Fold', 'Zonrox Color Safe Bleach', 10::numeric),
         ('Wash Only', 'Surf Liquid Detergent', 100::numeric),
         ('Wash Only', 'Surf Fabric Conditioner', 100::numeric),
         ('Wash Only', 'Zonrox Color Safe Bleach', 10::numeric),
         ('Bedsheet', 'Surf Liquid Detergent', 100::numeric),
         ('Bedsheet', 'Surf Fabric Conditioner', 100::numeric),
         ('Bedsheet', 'Zonrox Color Safe Bleach', 10::numeric),
         ('Comforter', 'Surf Liquid Detergent', 100::numeric),
         ('Comforter', 'Surf Fabric Conditioner', 100::numeric),
         ('Comforter', 'Zonrox Color Safe Bleach', 10::numeric)
       ) as r(service_name, item_name, qty)
 where sc.service_id = s.id
   and sc.inventory_item_id = i.id
   and s.name = r.service_name
   and i.name = r.item_name;

insert into public.service_consumables (service_id, inventory_item_id, qty_per_unit, unit, basis, is_placeholder)
select s.id, i.id, r.qty, 'ml', 'wash', false
  from public.services s,
       public.inventory_items i,
       (values
         ('Wash, Dry & Fold', 'Surf Liquid Detergent', 100::numeric),
         ('Wash, Dry & Fold', 'Surf Fabric Conditioner', 100::numeric),
         ('Wash, Dry & Fold', 'Zonrox Color Safe Bleach', 10::numeric),
         ('Wash Only', 'Surf Liquid Detergent', 100::numeric),
         ('Wash Only', 'Surf Fabric Conditioner', 100::numeric),
         ('Wash Only', 'Zonrox Color Safe Bleach', 10::numeric),
         ('Bedsheet', 'Surf Liquid Detergent', 100::numeric),
         ('Bedsheet', 'Surf Fabric Conditioner', 100::numeric),
         ('Bedsheet', 'Zonrox Color Safe Bleach', 10::numeric),
         ('Comforter', 'Surf Liquid Detergent', 100::numeric),
         ('Comforter', 'Surf Fabric Conditioner', 100::numeric),
         ('Comforter', 'Zonrox Color Safe Bleach', 10::numeric)
       ) as r(service_name, item_name, qty)
 where s.name = r.service_name
   and i.name = r.item_name
   and not exists (
     select 1 from public.service_consumables sc
      where sc.service_id = s.id and sc.inventory_item_id = i.id
   );
