-- Sales reporting is an owner concern: the shop spec assigns reports to the
-- Admin/Owner role, and the web app already limits the reports page to admins.
create or replace function public.sales_summary(
  p_from timestamptz,
  p_to timestamptz,
  p_granularity text default 'day'
)
returns table (bucket timestamptz, channel text, total numeric, payment_count bigint)
language plpgsql
stable
security definer
set search_path = public
as $$
begin
  if not public.is_admin() then
    raise exception 'Only the shop owner can read sales reports' using errcode = '42501';
  end if;
  if p_granularity not in ('day','week','month') then
    raise exception 'Invalid granularity: %', p_granularity using errcode = '22023';
  end if;

  return query
  select date_trunc(p_granularity, p.paid_at)::timestamptz as bucket,
         p.channel,
         sum(p.amount)::numeric as total,
         count(*)::bigint as payment_count
    from public.payments p
   where p.paid_at >= p_from and p.paid_at < p_to
   group by 1, 2
   order by 1 desc, 2 asc;
end;
$$;
