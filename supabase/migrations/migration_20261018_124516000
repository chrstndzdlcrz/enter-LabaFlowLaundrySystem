-- LabaFlow: inventory movements, orders + lifecycle, payments, receipts

-- Cleanup of a no-op permissive policy created earlier in this same project's
-- foundation migration: `using (false)` grants nothing and only adds noise.
drop policy if exists service_consumables_select_public_for_services on public.service_consumables;

create sequence if not exists public.order_code_seq;
create sequence if not exists public.receipt_no_seq;

-- ------------------------------------------------------- inventory movements
create table public.inventory_movements (
  id uuid primary key default gen_random_uuid(),
  item_id uuid not null references public.inventory_items(id) on delete cascade,
  delta numeric(12,3) not null,
  quantity_after numeric(12,3) not null default 0,
  shortage numeric(12,3) not null default 0,
  reason text not null default 'adjustment' check (reason in ('consumption','purchase','adjustment','waste','return')),
  order_id uuid,
  note text,
  created_by uuid references public.profiles(id),
  created_at timestamptz not null default now()
);

create index inventory_movements_item_idx on public.inventory_movements (item_id, created_at desc);

alter table public.inventory_movements enable row level security;

create policy inventory_movements_select_staff on public.inventory_movements
  for select to authenticated using (public.is_staff());

create policy inventory_movements_insert_staff on public.inventory_movements
  for insert to authenticated with check (public.is_staff());

grant select, insert on public.inventory_movements to authenticated;

-- Applies the stock change and records the real resulting quantity.
-- Stock is never allowed to go negative: the shortfall is recorded instead of
-- silently producing a negative count.
create or replace function public.apply_inventory_movement()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_current numeric;
  v_new numeric;
begin
  select quantity into v_current from public.inventory_items where id = new.item_id for update;
  if v_current is null then
    raise exception 'Inventory item not found' using errcode = 'P0002';
  end if;

  v_new := v_current + new.delta;
  if v_new < 0 then
    new.shortage := -v_new;
    new.note := coalesce(new.note || ' | ', '') || 'Stock shortage recorded: ' || (-v_new)::text || ' unit(s) below zero';
    v_new := 0;
  end if;

  update public.inventory_items set quantity = v_new, updated_at = now() where id = new.item_id;
  new.quantity_after := v_new;
  new.created_by := coalesce(new.created_by, auth.uid());
  return new;
end;
$$;

create trigger inventory_movements_apply
  before insert on public.inventory_movements
  for each row execute function public.apply_inventory_movement();

-- -------------------------------------------------------------------- orders
create table public.orders (
  id uuid primary key default gen_random_uuid(),
  order_code text unique,
  customer_id uuid references public.profiles(id) on delete set null,
  is_walk_in boolean not null default false,
  customer_name text not null,
  customer_phone text,
  status text not null default 'pending'
    check (status in ('pending','confirmed','received','in_progress','ready_for_pickup','completed','cancelled')),
  notes text,
  pickup_at timestamptz,
  subtotal numeric(10,2) not null default 0,
  discount numeric(10,2) not null default 0,
  total_amount numeric(10,2) not null default 0,
  amount_paid numeric(10,2) not null default 0,
  payment_status text not null default 'unpaid' check (payment_status in ('unpaid','partial','paid')),
  created_by uuid references public.profiles(id),
  assigned_to uuid references public.profiles(id),
  consumption_applied_at timestamptz,
  ready_notified_at timestamptz,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index orders_customer_idx on public.orders (customer_id, created_at desc);
create index orders_status_idx on public.orders (status, created_at desc);

alter table public.orders enable row level security;

create policy orders_select_customer on public.orders
  for select to authenticated using (customer_id = auth.uid());

create policy orders_select_staff on public.orders
  for select to authenticated using (public.is_staff());

create policy orders_insert_staff on public.orders
  for insert to authenticated with check (public.is_staff());

create policy orders_update_staff on public.orders
  for update to authenticated using (public.is_staff()) with check (public.is_staff());

-- Customers get no direct INSERT/UPDATE/DELETE: booking and cancellation go
-- through the validated functions below, and orders are never deleted.
grant select, insert, update on public.orders to authenticated;

alter publication supabase_realtime add table public.orders;

create table public.order_items (
  id uuid primary key default gen_random_uuid(),
  order_id uuid not null references public.orders(id) on delete cascade,
  service_id uuid references public.services(id) on delete set null,
  service_name text not null,
  unit text not null default 'kg',
  quantity numeric(10,3) not null check (quantity > 0),
  unit_price numeric(10,2) not null check (unit_price >= 0),
  line_total numeric(10,2) not null default 0,
  created_at timestamptz not null default now()
);

create index order_items_order_idx on public.order_items (order_id);

alter table public.order_items enable row level security;

create policy order_items_select on public.order_items
  for select to authenticated
  using (exists (
    select 1 from public.orders o
    where o.id = order_items.order_id and (o.customer_id = auth.uid() or public.is_staff())
  ));

create policy order_items_write_staff on public.order_items
  for all to authenticated
  using (public.is_staff()) with check (public.is_staff());

grant select, insert, update, delete on public.order_items to authenticated;

create table public.order_status_history (
  id uuid primary key default gen_random_uuid(),
  order_id uuid not null references public.orders(id) on delete cascade,
  from_status text,
  to_status text not null,
  changed_by uuid references public.profiles(id),
  changed_by_name text,
  note text,
  created_at timestamptz not null default now()
);

create index order_status_history_order_idx on public.order_status_history (order_id, created_at);

alter table public.order_status_history enable row level security;

create policy order_status_history_select on public.order_status_history
  for select to authenticated
  using (exists (
    select 1 from public.orders o
    where o.id = order_status_history.order_id and (o.customer_id = auth.uid() or public.is_staff())
  ));

grant select on public.order_status_history to authenticated;

create or replace function public.assign_order_code()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if new.order_code is null or new.order_code = '' then
    new.order_code := 'LFD-' || to_char(now(), 'YYMM') || '-' || lpad(nextval('public.order_code_seq')::text, 4, '0');
  end if;
  return new;
end;
$$;

create trigger orders_assign_code
  before insert on public.orders
  for each row execute function public.assign_order_code();

create or replace function public.refresh_order_totals()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_order_id uuid := coalesce(new.order_id, old.order_id);
  v_subtotal numeric;
begin
  select coalesce(sum(line_total), 0) into v_subtotal from public.order_items where order_id = v_order_id;
  update public.orders
     set subtotal = v_subtotal,
         total_amount = greatest(v_subtotal - discount, 0),
         updated_at = now()
   where id = v_order_id;
  return null;
end;
$$;

create trigger order_items_refresh_totals
  after insert or update or delete on public.order_items
  for each row execute function public.refresh_order_totals();

-- Lifecycle guard + status history + ready-for-pickup notification + consumption.
create or replace function public.handle_order_status_change()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_allowed text[];
  v_name text;
  v_stage text;
begin
  new.updated_at := now();

  if new.status is distinct from old.status then
    v_allowed := case old.status
      when 'pending' then array['confirmed','cancelled']
      when 'confirmed' then array['received','cancelled']
      when 'received' then array['in_progress','cancelled']
      when 'in_progress' then array['ready_for_pickup','cancelled']
      when 'ready_for_pickup' then array['completed','in_progress']
      else array[]::text[]
    end;

    if not (new.status = any (v_allowed)) then
      raise exception 'Invalid status change: % -> %', old.status, new.status using errcode = '22023';
    end if;

    select full_name into v_name from public.profiles where id = auth.uid();

    insert into public.order_status_history (order_id, from_status, to_status, changed_by, changed_by_name, note)
    values (new.id, old.status, new.status, auth.uid(), coalesce(v_name, 'System'), new.notes);

    -- Only a real customer order that actually became ready produces a notification.
    if new.status = 'ready_for_pickup' and new.customer_id is not null then
      insert into public.notifications (user_id, order_id, type, title, body)
      values (
        new.customer_id,
        new.id,
        'order_ready',
        'Your laundry is ready for pick-up',
        'Order ' || coalesce(new.order_code, '') || ' is ready for pick-up at Lab-a-Day Laundry Shop.'
      )
      on conflict (order_id) where type = 'order_ready'
      do update set title = excluded.title,
                    body = excluded.body,
                    push_status = 'pending',
                    push_error = null,
                    push_attempts = 0,
                    read_at = null,
                    created_at = now();
      new.ready_notified_at := now();
    end if;

    select consumption_stage into v_stage from public.shop_settings where id;
    if new.status = coalesce(v_stage, 'in_progress') and new.consumption_applied_at is null then
      insert into public.inventory_movements (item_id, delta, reason, order_id, note, created_by)
      select sc.inventory_item_id,
             -1 * (sc.qty_per_unit * oi.quantity),
             'consumption',
             new.id,
             'Auto consumption for ' || coalesce(new.order_code, '') || ' (' || oi.service_name || ')',
             auth.uid()
      from public.order_items oi
      join public.service_consumables sc on sc.service_id = oi.service_id
      where oi.order_id = new.id;

      new.consumption_applied_at := now();
    end if;
  end if;

  return new;
end;
$$;

create trigger orders_status_change
  before update on public.orders
  for each row execute function public.handle_order_status_change();

-- -------------------------------------------------------- booking / walk-in
create or replace function public.apply_order_items(p_order_id uuid, p_items jsonb)
returns void
language plpgsql
security definer
set search_path = public
as $$
declare
  v_item jsonb;
  v_service public.services;
  v_qty numeric;
begin
  if p_items is null or jsonb_typeof(p_items) <> 'array' or jsonb_array_length(p_items) = 0 then
    raise exception 'Add at least one service' using errcode = '22023';
  end if;

  for v_item in select * from jsonb_array_elements(p_items) loop
    v_qty := coalesce((v_item ->> 'quantity')::numeric, 0);
    if v_qty <= 0 then
      raise exception 'Quantity must be greater than zero' using errcode = '22023';
    end if;

    select * into v_service from public.services
     where id = (v_item ->> 'service_id')::uuid and is_active;
    if v_service.id is null then
      raise exception 'That service is not available anymore' using errcode = '22023';
    end if;

    insert into public.order_items (order_id, service_id, service_name, unit, quantity, unit_price, line_total)
    values (p_order_id, v_service.id, v_service.name, v_service.unit, v_qty, v_service.price, round(v_service.price * v_qty, 2));
  end loop;
end;
$$;

create or replace function public.create_booking(
  p_items jsonb,
  p_notes text default null,
  p_pickup_at timestamptz default null
)
returns public.orders
language plpgsql
security definer
set search_path = public
as $$
declare
  v_uid uuid := auth.uid();
  v_profile public.profiles;
  v_order public.orders;
begin
  if v_uid is null then
    raise exception 'Not authenticated' using errcode = '42501';
  end if;

  select * into v_profile from public.profiles where id = v_uid;
  if v_profile.id is null then
    raise exception 'Profile not found' using errcode = 'P0002';
  end if;

  insert into public.orders (
    customer_id, is_walk_in, customer_name, customer_phone, status, notes, pickup_at, created_by
  ) values (
    v_uid, false, coalesce(nullif(v_profile.full_name, ''), v_profile.email, 'Customer'),
    v_profile.phone, 'pending', nullif(trim(coalesce(p_notes, '')), ''), p_pickup_at, v_uid
  ) returning * into v_order;

  perform public.apply_order_items(v_order.id, p_items);

  select * into v_order from public.orders where id = v_order.id;
  return v_order;
end;
$$;

grant execute on function public.create_booking(jsonb, text, timestamptz) to authenticated;

create or replace function public.create_walk_in_order(
  p_customer_name text,
  p_customer_phone text,
  p_items jsonb,
  p_notes text default null,
  p_link_customer_id uuid default null
)
returns public.orders
language plpgsql
security definer
set search_path = public
as $$
declare
  v_order public.orders;
begin
  if not public.is_staff() then
    raise exception 'Only shop staff can create walk-in orders' using errcode = '42501';
  end if;
  if coalesce(trim(p_customer_name), '') = '' then
    raise exception 'Customer name is required' using errcode = '22023';
  end if;

  insert into public.orders (
    customer_id, is_walk_in, customer_name, customer_phone, status, notes, created_by, assigned_to
  ) values (
    p_link_customer_id, true, trim(p_customer_name), nullif(trim(coalesce(p_customer_phone, '')), ''),
    'received', nullif(trim(coalesce(p_notes, '')), ''), auth.uid(), auth.uid()
  ) returning * into v_order;

  perform public.apply_order_items(v_order.id, p_items);

  select * into v_order from public.orders where id = v_order.id;
  return v_order;
end;
$$;

grant execute on function public.create_walk_in_order(text, text, jsonb, text, uuid) to authenticated;

create or replace function public.cancel_my_order(p_order_id uuid)
returns public.orders
language plpgsql
security definer
set search_path = public
as $$
declare
  v_order public.orders;
begin
  if auth.uid() is null then
    raise exception 'Not authenticated' using errcode = '42501';
  end if;

  select * into v_order from public.orders
   where id = p_order_id and customer_id = auth.uid() for update;
  if v_order.id is null then
    raise exception 'Order not found' using errcode = 'P0002';
  end if;
  if v_order.status not in ('pending','confirmed') then
    raise exception 'This order can no longer be cancelled online. Please contact the shop.' using errcode = '22023';
  end if;

  update public.orders set status = 'cancelled', updated_at = now()
   where id = p_order_id returning * into v_order;
  return v_order;
end;
$$;

grant execute on function public.cancel_my_order(uuid) to authenticated;

-- -------------------------------------------------------- payments, receipts
create table public.payments (
  id uuid primary key default gen_random_uuid(),
  order_id uuid not null references public.orders(id) on delete cascade,
  amount numeric(10,2) not null check (amount > 0),
  channel text not null,
  reference_no text,
  notes text,
  received_by uuid references public.profiles(id),
  paid_at timestamptz not null default now(),
  created_at timestamptz not null default now()
);

create index payments_order_idx on public.payments (order_id);
create index payments_paid_at_idx on public.payments (paid_at desc);

alter table public.payments enable row level security;

create policy payments_select_own_or_staff on public.payments
  for select to authenticated
  using (
    public.is_staff()
    or exists (select 1 from public.orders o where o.id = payments.order_id and o.customer_id = auth.uid())
  );

create policy payments_insert_staff on public.payments
  for insert to authenticated with check (public.is_staff());

grant select, insert on public.payments to authenticated;

create or replace function public.handle_payment_insert()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_order public.orders;
  v_paid numeric := 0;
  v_status text;
  v_channel text;
  v_snapshot jsonb;
begin
  new.received_by := coalesce(new.received_by, auth.uid());

  select * into v_order from public.orders where id = new.order_id for update;
  if v_order.id is null then
    raise exception 'Order not found' using errcode = 'P0002';
  end if;
  if v_order.status = 'cancelled' then
    raise exception 'Cannot record a payment for a cancelled order' using errcode = '22023';
  end if;

  select coalesce(sum(amount), 0) into v_paid from public.payments where order_id = new.order_id;
  v_status := case when v_paid >= v_order.total_amount then 'paid'
                   when v_paid > 0 then 'partial'
                   else 'unpaid' end;
  select p.channel into v_channel from public.payments p
   where p.order_id = new.order_id order by p.paid_at desc limit 1;

  update public.orders
     set amount_paid = v_paid,
         payment_status = v_status,
         status = case when v_order.status = 'ready_for_pickup' and v_paid >= v_order.total_amount
                       then 'completed' else v_order.status end,
         updated_at = now()
   where id = new.order_id;

  v_snapshot := jsonb_build_object(
    'shop', (select jsonb_build_object('name', shop_name, 'address', address, 'phone', phone, 'footer', receipt_footer)
               from public.shop_settings where id),
    'order_code', v_order.order_code,
    'customer_name', v_order.customer_name,
    'customer_phone', v_order.customer_phone,
    'is_walk_in', v_order.is_walk_in,
    'created_at', v_order.created_at,
    'items', coalesce((
      select jsonb_agg(jsonb_build_object(
        'name', service_name, 'unit', unit, 'quantity', quantity,
        'unit_price', unit_price, 'line_total', line_total))
      from public.order_items where order_id = v_order.id), '[]'::jsonb),
    'subtotal', v_order.subtotal,
    'discount', v_order.discount,
    'total', v_order.total_amount,
    'amount_paid', v_paid,
    'payment_status', v_status,
    'payments', coalesce((
      select jsonb_agg(jsonb_build_object('amount', amount, 'channel', channel,
        'reference_no', reference_no, 'paid_at', paid_at))
      from public.payments where order_id = v_order.id), '[]'::jsonb)
  );

  insert into public.receipts (
    order_id, receipt_no, issued_by, subtotal, discount, total, amount_paid, channel, is_final, snapshot
  ) values (
    v_order.id,
    'LFD-' || to_char(now(), 'YYYYMM') || '-' || lpad(nextval('public.receipt_no_seq')::text, 4, '0'),
    auth.uid(), v_order.subtotal, v_order.discount, v_order.total_amount, v_paid,
    coalesce(v_channel, new.channel), v_status = 'paid', v_snapshot
  )
  on conflict (order_id) do update
    set subtotal = excluded.subtotal,
        discount = excluded.discount,
        total = excluded.total,
        amount_paid = excluded.amount_paid,
        channel = excluded.channel,
        is_final = excluded.is_final,
        snapshot = excluded.snapshot,
        issued_at = now();

  return new;
end;
$$;

create trigger payments_after_insert
  before insert on public.payments
  for each row execute function public.handle_payment_insert();

create table public.receipts (
  id uuid primary key default gen_random_uuid(),
  order_id uuid not null unique references public.orders(id) on delete cascade,
  receipt_no text not null unique,
  issued_by uuid references public.profiles(id),
  subtotal numeric(10,2) not null default 0,
  discount numeric(10,2) not null default 0,
  total numeric(10,2) not null default 0,
  amount_paid numeric(10,2) not null default 0,
  channel text,
  is_final boolean not null default false,
  snapshot jsonb not null default '{}'::jsonb,
  issued_at timestamptz not null default now()
);

alter table public.receipts enable row level security;

create policy receipts_select_own_or_staff on public.receipts
  for select to authenticated
  using (
    public.is_staff()
    or exists (select 1 from public.orders o where o.id = receipts.order_id and o.customer_id = auth.uid())
  );

grant select on public.receipts to authenticated;

-- ------------------------------------------------------ sales reporting RPC
create or replace function public.sales_summary(
  p_from timestamptz,
  p_to timestamptz,
  p_granularity text default 'day'
)
returns table (bucket timestamptz, channel text, total numeric, payment_count bigint)
language plpgsql
stable
security definer
set search_path = public
as $$
begin
  if not public.is_staff() then
    raise exception 'Only shop staff can read sales reports' using errcode = '42501';
  end if;
  if p_granularity not in ('day','week','month') then
    raise exception 'Invalid granularity: %', p_granularity using errcode = '22023';
  end if;

  return query
  select date_trunc(p_granularity, p.paid_at)::timestamptz as bucket,
         p.channel,
         sum(p.amount)::numeric as total,
         count(*)::bigint as payment_count
    from public.payments p
   where p.paid_at >= p_from and p.paid_at < p_to
   group by 1, 2
   order by 1 desc, 2 asc;
end;
$$;

grant execute on function public.sales_summary(timestamptz, timestamptz, text) to authenticated;
