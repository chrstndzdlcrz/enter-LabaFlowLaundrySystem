-- A customer or staff member may switch their own account off (an administrator can
-- switch it back on). Nobody may re-activate themselves, and an administrator is
-- never allowed to lock the shop out by deactivating their own account.
create or replace function public.guard_profile_update()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if auth.uid() is null or public.is_admin() then
    new.updated_at := now();
    return new;
  end if;

  if new.role is distinct from old.role then
    raise exception 'Only an administrator can change account roles' using errcode = '42501';
  end if;

  if new.is_active is distinct from old.is_active then
    if not (new.id = auth.uid() and old.is_active = true and new.is_active = false) then
      raise exception 'Only an administrator can change account status' using errcode = '42501';
    end if;
  end if;

  if new.id is distinct from old.id or new.email is distinct from old.email then
    raise exception 'This profile field is immutable' using errcode = '42501';
  end if;

  new.updated_at := now();
  return new;
end;
$$;
